<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/bg_card_rounded"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_hist_meal_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Breakfast"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_hist_meal_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8:30 AM"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_hist_meal_insulin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Insulin: 4.0u at 8:15 AM"
        android:textColor="@color/clinical_insulin"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/text_hist_meal_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="0 kcal | C: 0g | P: 0g | F: 0g (Sat: 0g)"
        android:textColor="?attr/colorOnSurface"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/text_hist_meal_secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="Fiber: 0g • Chol: 0mg • Carbs: 0g • Ω-3: 0g • Ω-6: 0g"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/text_hist_meal_items"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="11sp" />

</LinearLayout>
