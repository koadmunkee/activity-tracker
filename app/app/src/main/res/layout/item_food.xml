<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    app:cardBackgroundColor="@color/clinical_card_bg"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/clinical_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top row: Name, Ref Weight badge, Edit, Archive/Unarchive buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_item_food_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Food Name"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_item_food_ref_weight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="per 100g"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp" />

            <!-- Edit Button (FR 5.4) -->
            <ImageButton
                android:id="@+id/btn_edit_food"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_edit"
                android:src="@drawable/ic_edit"
                app:tint="?attr/colorPrimary" />

            <!-- Archive / Unarchive Button (FR 5.2, 5.3) -->
            <ImageButton
                android:id="@+id/btn_archive_food"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/archive_food"
                android:src="@drawable/ic_archive"
                app:tint="?attr/colorSecondary" />
        </LinearLayout>

        <!-- Primary Nutrients Row (FR 5.5, 5.6) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="5">

            <TextView
                android:id="@+id/text_food_calories"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="0 kcal"
                android:textColor="@color/nutrient_calories"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_food_dig_carbs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="C: 0g"
                android:textColor="@color/nutrient_carbs"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_food_sat_fat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Sat: 0g"
                android:textColor="@color/nutrient_sat_fat"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_food_fat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="F: 0g"
                android:textColor="@color/nutrient_fat"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_food_protein"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="P: 0g"
                android:textColor="@color/nutrient_protein"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Secondary Nutrients Row (FR 5.5, 5.6) -->
        <TextView
            android:id="@+id/text_food_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Fiber: 0g • Chol: 0mg • Carbs: 0g • Ω-3: 0g • Ω-6: 0g"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="10sp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
