<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_tpl_food_name"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/food_hint">

            <AutoCompleteTextView
                android:id="@+id/actv_tpl_food_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:completionThreshold="1"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:popupBackground="@color/autocomplete_bg"
                android:textColor="@color/autocomplete_text"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_tpl_food_weight"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="85dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:hint="@string/weight_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_tpl_food_weight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <ImageButton
            android:id="@+id/btn_tpl_delete_row"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_delete"
            android:src="@drawable/ic_delete"
            app:tint="?attr/colorError" />
    </LinearLayout>

    <!-- Food-level nutrients for template (FR 3.1) -->
    <TextView
        android:id="@+id/text_tpl_row_nutrients"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="0 kcal | C: 0g | P: 0g | F: 0g (Fib: 0g, Chol: 0mg)"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="10sp" />

</LinearLayout>
