<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    app:cardBackgroundColor="@color/clinical_card_bg"
    app:cardCornerRadius="10dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/clinical_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Top row: Food autocomplete, weight input, delete button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Food Autocomplete Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_food_name"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/food_hint">

                <AutoCompleteTextView
                    android:id="@+id/actv_food_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:completionThreshold="1"
                    android:dropDownWidth="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:popupBackground="@color/autocomplete_bg"
                    android:textColor="@color/autocomplete_text"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Weight Input (g) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_food_weight"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="95dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:hint="@string/weight_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_food_weight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Delete Row Button -->
            <ImageButton
                android:id="@+id/btn_delete_food_row"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete Food Row"
                android:src="@drawable/ic_delete"
                app:tint="?attr/colorError" />
        </LinearLayout>

        <!-- Primary Nutrients Display for this food row (FR 2.4) -->
        <LinearLayout
            android:id="@+id/layout_primary_nutrients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:weightSum="5">

            <TextView
                android:id="@+id/text_row_calories"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="0 kcal"
                android:textColor="@color/nutrient_calories"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_row_dig_carbs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="C: 0g"
                android:textColor="@color/nutrient_carbs"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_row_sat_fat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Sat: 0g"
                android:textColor="@color/nutrient_sat_fat"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_row_fat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="F: 0g"
                android:textColor="@color/nutrient_fat"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_row_protein"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="P: 0g"
                android:textColor="@color/nutrient_protein"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Secondary Nutrients for this food row (FR 2.4: less prominent) -->
        <TextView
            android:id="@+id/text_row_secondary_nutrients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Fiber: 0g • Chol: 0mg • Carbs: 0g • Ω-3: 0g • Ω-6: 0g"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="10sp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
